{
  "name": "@agent-tasks/browser-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-tasks/shared": "workspace:*",
    "fastify": "catalog:",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "zod": "catalog:",
    "@agent-tasks/browser-tools": "workspace:*"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "tsup": "catalog:"
  }
}
