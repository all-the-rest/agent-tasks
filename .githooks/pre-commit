#!/bin/sh
# Fast, local gates. The full suite (integration, E2E, container scans) belongs to
# CI; this hook catches what is cheap to catch before a commit exists.
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

echo "pre-commit: secret scan"
secret_hit=0
while IFS= read -r staged_path; do
  [ -n "$staged_path" ] || continue
  [ -f "$staged_path" ] || continue
  if grep -nIE 'sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|BEGIN [A-Z ]*PRIVATE KEY|AUTH_SECRET=[A-Za-z0-9]{16,}' -- "$staged_path"; then
    secret_hit=1
  fi
done <<EOF
$staged
EOF
if [ "$secret_hit" -ne 0 ]; then
  echo "pre-commit: refusing to commit a secret-looking string" >&2
  exit 1
fi

pinned=$(tr -d '[:space:]' < .ratchet-version 2>/dev/null || true)
if [ -n "$pinned" ]; then
  installed=$(ratchet --version 2>/dev/null | awk '{print $2}')
  if [ "$installed" != "$pinned" ]; then
    echo "pre-commit: ratchet $pinned is required (found ${installed:-none}); run scripts/install-ratchet.sh" >&2
    exit 1
  fi
fi

echo "pre-commit: ratchet gates"
ratchet check --format stylish >/dev/null || { ratchet check; exit 1; }

# Match every staged path individually. Matching the newline-joined list as one
# string (case "$staged") only ever tested the first/last entry and silently
# skipped lint/typecheck for mixed commits.
needs_checks=0
while IFS= read -r staged_path; do
  [ -n "$staged_path" ] || continue
  case "$staged_path" in
    *.ts|*.tsx|*.mjs|*.js|*.json|*.yaml|*.yml|*.md|*.sh|Dockerfile*|*/Dockerfile*|*.css)
      needs_checks=1
      break
      ;;
  esac
done <<EOF
$staged
EOF
if [ "$needs_checks" -eq 1 ]; then
  echo "pre-commit: lint"
  pnpm lint --quiet || exit 1
  echo "pre-commit: typecheck"
  pnpm -r typecheck >/dev/null || { pnpm -r typecheck; exit 1; }
fi

if command -v codegraph >/dev/null 2>&1 && [ -d .codegraph ]; then
  echo "pre-commit: codegraph sync"
  codegraph sync . >/dev/null 2>&1 || echo "pre-commit: codegraph sync skipped"
fi

echo "pre-commit: ok"
