# syntax=docker/dockerfile:1.7
FROM node:22.20.0-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
# Corepack bundled with node:22.20.0 launches pnpm through bin/pnpm.cjs, but
# pnpm 12.x ships bin/pnpm.mjs, so the shim fails with MODULE_NOT_FOUND. Install
# the exact pinned version with npm instead.
RUN npm install -g pnpm@12.9.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
RUN pnpm install --frozen-lockfile --filter @agent-tasks/web...
RUN pnpm --filter @agent-tasks/web build

FROM nginxinc/nginx-unprivileged:1.29-alpine
# The image's nginx.conf writes its pid and temp files under /tmp. compose.yaml
# runs this container read-only with tmpfs only at /var/cache/nginx and
# /var/run, so the replacement config redirects every writable path there.
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
# The entrypoint rewrites default.conf's listen directive at startup; with a
# read-only root filesystem that is impossible and unnecessary (we listen on
# 8080 explicitly). nginx-unprivileged runs as uid 101, which cannot delete this
# root-owned file, so the removal happens as root and the image switches back.
USER root
RUN rm -f /docker-entrypoint.d/10-listen-on-ipv6-by-default.sh
USER 101
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
