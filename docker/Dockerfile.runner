# syntax=docker/dockerfile:1.7
# Pinned Playwright base: Chromium, its system libraries and the non-root user
# `pwuser` come from the vendor image, so the runner never downloads a browser at
# runtime and never runs as root.
FROM mcr.microsoft.com/playwright:v1.64.1-noble AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
# Corepack bundled with node:22.20.0 launches pnpm through bin/pnpm.cjs, but
# pnpm 12.x ships bin/pnpm.mjs, so the shim fails with MODULE_NOT_FOUND. Install
# the exact pinned version with npm instead.
RUN npm install -g pnpm@12.9.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @agent-tasks/browser-runner build

FROM mcr.microsoft.com/playwright:v1.64.1-noble
ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/home/pwuser
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/services/browser-runner/dist ./services/browser-runner/dist
COPY --from=build /app/services/browser-runner/package.json ./services/browser-runner/package.json
# tsup externalises runtime dependencies, so the service's own node_modules
# (pnpm symlinks into the root store) must be present or Node cannot resolve them.
COPY --from=build /app/services/browser-runner/node_modules ./services/browser-runner/node_modules
USER pwuser
EXPOSE 8081
CMD ["node", "services/browser-runner/dist/index.js"]
