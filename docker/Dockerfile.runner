# syntax=docker/dockerfile:1.7
# Build stage: full toolchain and source. It never reaches the deploy image.
FROM node:22.20.0-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN npm install -g pnpm@12.9.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @agent-tasks/browser-runner build

FROM node:22.20.0-bookworm-slim AS prod-deps
# Production-only closure for the deploy image.
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN npm install -g pnpm@12.9.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --no-optional \
      --filter '@agent-tasks/browser-runner...'

FROM node:22.20.0-bookworm-slim AS deploy
# Deploy layer: runtime libraries + headless Chromium only; no compiler, pnpm
# store, Firefox or WebKit. The runner launches headless, so the shell build is
# enough and keeps the published image roughly half the size of the vendor image.
ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HOME=/home/pwuser
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/services/browser-runner/dist ./services/browser-runner/dist
COPY --from=build /app/services/browser-runner/package.json ./services/browser-runner/package.json
COPY --from=prod-deps /app/services/browser-runner/node_modules ./services/browser-runner/node_modules
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && node services/browser-runner/node_modules/playwright/cli.js install --with-deps --only-shell chromium \
 && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1001 pwuser \
 && useradd --create-home --uid 1001 --gid pwuser pwuser \
 && chown -R pwuser:pwuser /ms-playwright /app
USER pwuser
EXPOSE 8081
CMD ["node", "services/browser-runner/dist/index.js"]
