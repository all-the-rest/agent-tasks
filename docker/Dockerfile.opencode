# syntax=docker/dockerfile:1.7
FROM node:22.20.0-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN npm install --global pnpm@12.9.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/opencode-sdk-runtime/package.json services/opencode-sdk-runtime/package.json
RUN pnpm install --filter @agent-tasks/opencode-sdk-runtime --prod --frozen-lockfile --ignore-scripts

FROM oven/bun:1.3.14 AS runtime
ENV HOME=/home/opencode
RUN groupadd --system --gid 10001 opencode \
 && useradd --system --uid 10001 --gid opencode --create-home --home-dir /home/opencode opencode \
 && mkdir -p /etc/opencode /home/opencode/.config /home/opencode/.local/share/opencode /home/opencode/.local/state /home/opencode/.cache /workspace /app/services/opencode-sdk-runtime \
 && chown -R opencode:opencode /home/opencode /workspace
COPY --from=dependencies --chown=root:root /app/node_modules /app/node_modules
COPY --from=dependencies --chown=root:root /app/services/opencode-sdk-runtime/node_modules /app/services/opencode-sdk-runtime/node_modules
COPY --chown=root:root services/opencode-sdk-runtime/host.mjs /app/services/opencode-sdk-runtime/host.mjs
COPY --chown=root:root docker/opencode.json /etc/opencode/opencode.json
RUN chmod 0444 /app/services/opencode-sdk-runtime/host.mjs /etc/opencode/opencode.json
WORKDIR /app/services/opencode-sdk-runtime
USER 10001:10001
EXPOSE 4096
ENTRYPOINT ["bun", "run", "host.mjs"]
