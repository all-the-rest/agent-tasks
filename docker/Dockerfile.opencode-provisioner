FROM node:22.20.0-bookworm-slim
ENV NODE_ENV=production
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates docker.io \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/opencode-provisioner/server.mjs ./server.mjs
USER root
EXPOSE 4090
CMD ["node", "server.mjs"]
