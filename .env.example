# ---------------------------------------------------------------------------
# Agent Tasks — copy to .env and change every secret before the first start.
# Compose interpolates this file. Variables marked "not forwarded by
# compose.yaml" are read by the application but must be added to the matching
# service environment to take effect.
# ---------------------------------------------------------------------------

# Postgres credentials (the database port is never published).
POSTGRES_USER=agent
# Keep this hex: it is embedded in DATABASE_URL without escaping.
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=agent_tasks

# Public URL of the web app: auth URLs, invite/reset links and trusted origins.
PUBLIC_BASE_URL=http://localhost:8080
# Host interface and port published by the API (which also serves the SPA).
# Keep the loopback default in production; the TLS proxy is the public listener.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# "true" adds Secure to cookies (HTTPS only). SameSite=Lax is always set.
COOKIE_SECURE=false
# Set to "true" only behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# --- required secrets ------------------------------------------------------
# At least 32 characters: openssl rand -hex 32 (64 characters).
AUTH_SECRET=
# Exactly 32 bytes, base64: openssl rand -base64 32.
SECRETS_ENCRYPTION_KEY=
# Only while rotating keys: keeps old ciphertext readable until credentials are re-saved.
# SECRETS_ENCRYPTION_KEY_PREVIOUS=

# First-admin token. Required: at least 16 characters (openssl rand -hex 32).
# An empty value fails validation at API startup; without it /api/setup answers 503.
SETUP_TOKEN=

# Worker to browser-runner shared secret. Required, at least 16 characters:
# openssl rand -base64 24 (32 characters).
RUNNER_TOKEN=
# Worker-to-provisioner token; generate with: openssl rand -hex 32. The worker
# requires at least 32 characters and refuses to start without the token and URL.
# Compose sets the URL; for `pnpm dev` use OPENCODE_PROVISIONER_URL=http://127.0.0.1:4090
# with the test-only fake in services/opencode-test-provisioner (no provider calls).
OPENCODE_PROVISIONER_TOKEN=

# --- optional mail ---------------------------------------------------------
# Without SMTP_URL the mailer logs outside production and redacts links in
# production; invitations can still be copied from Admin -> Users.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=agent-tasks@example.com

# --- search ----------------------------------------------------------------
# Used by the worker. Start the backend with: docker compose --profile search up -d
# Without that profile, search requests fail (the searxng container is not running).
SEARXNG_URL=http://searxng:8080
# SearXNG's effective secret is server.secret_key in docker/searxng/settings.yml.
# The image only reads SEARXNG_SECRET when it creates a missing settings file, and
# that file is mounted, so change the key in the file instead.

# --- browser runner --------------------------------------------------------
# Allow plain http:// page loads (true) or require https (false).
RUNNER_ALLOW_HTTP=true
# Comma-separated destination ports the egress proxy may connect to.
RUNNER_ALLOWED_PORTS=80,443
RUNNER_MAX_SESSIONS=2
# Must exceed the 3600-second max task duration; includes 60 seconds for cleanup.
RUNNER_SESSION_TTL_MS=3660000
# Read by the runner; compose.yaml does not forward these two.
# RUNNER_ACTION_TIMEOUT_MS=30000
# RUNNER_MAX_TEXT_CHARS=30000
# compose.yaml pins this to "true"; edit the browser-runner service to change it.
# RUNNER_CHROMIUM_SANDBOX=true
BROWSER_MEMORY_LIMIT=1g
BROWSER_CPUS=1.0

# --- worker ----------------------------------------------------------------
# Parallel executions per worker process (1..8); sets pg-boss localConcurrency.
WORKER_CONCURRENCY=1
# Stable name for logs; compose.yaml does not forward it.
# WORKER_ID=worker-1

# --- API -------------------------------------------------------------------
# Global HTTP requests per minute and IP, including the SPA (default 300).
# E2E only: raise to 1000 for the multi-context Playwright suite.
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_SIGNIN_MAX=5
# RATE_LIMIT_SESSION_MAX=600
# RATE_LIMIT_WINDOW_SECONDS=60

# --- local development -----------------------------------------------------
# Compose sets NODE_ENV=production and builds DATABASE_URL itself. For running
# the API, worker and migrations on the host, uncomment and adjust:
# NODE_ENV=development
# DATABASE_URL=postgres://agent:agent@localhost:5432/agent_tasks

# --- logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- images ----------------------------------------------------------------
# Image reference used by compose; the auto-updater can pull it once published.
IMAGE_PREFIX=ghcr.io/all-the-rest/agent-tasks
IMAGE_TAG=latest
# Optional local image-build version; production consumes the published image tag.
OPENCODE_VERSION=2.2.5
# OpenCode container resource ceilings (Compose interpolation only).
OPENCODE_MEMORY_LIMIT=1g
OPENCODE_CPUS=1.0

# --- unsupported provider adapter -----------------------------------------
# The Codex adapter stays in packages/ai-providers for library tests and admin
# health checks only. The worker rejects the `codex` provider kind, so no task can
# execute through it.
# AGENT_TASKS_ENABLE_CODEX=1
# The production runtime provisioner is profile-gated; do not enable its profile
# until the production verification gates in docs/architecture/opencode-runtime-isolation.md pass.
