# Agent Tasks - production environment.
#
# Fill in every value marked "replace-" before deploying. Generate the secrets with:
#   openssl rand -hex 32   (AUTH_SECRET)
#   openssl rand -base64 32 (SECRETS_ENCRYPTION_KEY)
#   openssl rand -hex 24   (RUNNER_TOKEN)
#
# Start the stack with:
#   docker compose --env-file .env.production up -d
#
# Do not commit a filled-in copy: keep real secrets on the deployment host only.

NODE_ENV=production
PUBLIC_BASE_URL=https://tasks.example.com
HTTP_PORT=8080
COOKIE_SECURE=true
TRUST_PROXY=true

POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=agent_tasks

AUTH_SECRET=replace-with-32-random-bytes
SECRETS_ENCRYPTION_KEY=replace-with-32-random-bytes
RUNNER_TOKEN=replace-with-24-random-bytes

# First administrator. Created only when no ADMIN exists. Both must be set.
ADMIN_EMAIL=admin@example.com
# Required (at least 12 characters) when ADMIN_EMAIL is set.
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# The admin UI can change this later; false = invitations only.
ALLOW_REGISTRATION=false

# OpenCode Go. The provider is created (and its key encrypted) on first start.
OPENCODE_GO_API_KEY=replace-with-your-opencode-go-api-key
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Optional variant suffix: model-id#high (none|minimal|low|medium|high|xhigh)
OPENCODE_GO_MODEL=replace-with-a-model-id
# OPENCODE_GO_MODELS=model-a,model-b
OPENCODE_GO_NAME=OpenCode Go

SEARXNG_URL=http://searxng:8080
RUNNER_ALLOW_HTTP=true
RUNNER_ALLOWED_PORTS=80,443
