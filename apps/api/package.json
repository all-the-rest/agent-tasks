    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "^1.7.14",
    "fastify": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:",
    "nodemailer": "^10.0.6",
    "@types/nodemailer": "^7.0.2",
    "pg-boss": "^12.38.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "tsup": "catalog:"
