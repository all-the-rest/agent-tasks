# Production stack — deployment/compose.production.yaml
#
# HOST-ONLY FILE. On the Docker host create /opt/stacks/agent-tasks/.env from this
# example as root:root with mode 0600, then replace every "replace-with" value
# and the example domain/admin address:
#
#   sudo install -d -m 0755 /opt/stacks/agent-tasks
#   if ! sudo test -e /opt/stacks/agent-tasks/.env; then
#     sudo install -m 0600 -o root -g root \
#       deployment/env/production.env.example /opt/stacks/agent-tasks/.env
#   fi
#   sudoedit /opt/stacks/agent-tasks/.env
#
# Never overwrite an existing host .env (it holds the live secrets). Never create
# or use a local `deployment/env/production.env` as the production
# environment, and never tell deployment/stack.sh to start production: the host
# `/opt/stacks/agent-tasks/.env` is the only production environment.
# `deployment/stack.sh production config -q` uses this example for local
# validation only. The host .env must never be committed.
#
# deployment/compose.production.yaml requires POSTGRES_PASSWORD, PUBLIC_BASE_URL,
# AUTH_SECRET, SECRETS_ENCRYPTION_KEY, RUNNER_TOKEN, COOKIE_SECURE and TRUST_PROXY;
# there are no insecure production fallbacks. deploy.sh renders this file through
# `docker compose config` and checks the *effective* interpolated values
# (quoting and inline comments are interpreted exactly as Compose does), rejects
# empty values and placeholders, and never prints a value. The host needs
# python3 for that parser.

STACK_NAME=production

# --- public endpoint -------------------------------------------------------
# The API also serves the built SPA. It binds to loopback by default; the global
# TLS reverse proxy (Caddy) is the only public listener and proxies to this port.
# Use the public HTTPS URL in PUBLIC_BASE_URL.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
PUBLIC_BASE_URL=https://tasks.example.com
COOKIE_SECURE=true
TRUST_PROXY=true

# --- database --------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=agent_tasks

# --- required secrets ------------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=replace-with-64-hex-characters
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-base64-32-bytes
# openssl rand -hex 16
SETUP_TOKEN=replace-with-at-least-16-characters
# openssl rand -hex 24
# Passed to worker and browser-runner (equal value); never to the API.
RUNNER_TOKEN=replace-with-at-least-16-characters
# openssl rand -hex 32; worker-to-OpenCode service authentication only
OPENCODE_SERVER_PASSWORD=replace-with-64-hex-characters
# openssl rand -hex 32; worker-to-provisioner secret (only for experimental profile)
OPENCODE_PROVISIONER_TOKEN=

# --- first administrator ---------------------------------------------------
# Created only when no ADMIN exists. Set both, or set neither (remove the
# example email as well) to use the setup screen with SETUP_TOKEN instead.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Administrator
# Invitations only. The admin UI can change this later.
ALLOW_REGISTRATION=false

# --- mail -------------------------------------------------------------------
# Point SMTP_URL at the real relay; without it invitations are copied manually.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=agent-tasks@example.com

# --- search (profile "search") ---------------------------------------------
SEARXNG_URL=http://searxng:8080
# Enable the profile in this host-only file. The settings file is created once by
# the operator with a generated server.secret_key (see DEPLOYMENT.md); deploy.sh
# never installs the repository placeholder.
# COMPOSE_PROFILES=search
# Do not add `mail`: deploy.sh rejects an active mail profile because Mailpit
# publishes ports on all host interfaces. Use SMTP_URL with an external relay.

# --- browser runner --------------------------------------------------------
RUNNER_ALLOW_HTTP=true
RUNNER_ALLOWED_PORTS=80,443
RUNNER_MAX_SESSIONS=2
RUNNER_SESSION_TTL_MS=3660000
RUNNER_CHROMIUM_SANDBOX=true
BROWSER_MEMORY_LIMIT=1g
BROWSER_CPUS=1.0
# Host deployment: deploy.sh ships docker/seccomp-browser.json to the production
# default below and pins RUNNER_SECCOMP_PATH to that staged file for `up`. Do not
# keep an older /opt/agent-tasks override here; it is ignored for the deploy and
# only confuses manual compose commands.
# RUNNER_SECCOMP_PATH=/opt/stacks/agent-tasks/docker/seccomp-browser.json
# Search profile only: root:root 0600 host-only file with a generated secret.
# SEARXNG_SETTINGS_PATH=/opt/stacks/agent-tasks/docker/searxng/settings.yml

# --- worker and API --------------------------------------------------------
WORKER_CONCURRENCY=1
RATE_LIMIT_SIGNIN_MAX=5
RATE_LIMIT_SESSION_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# --- images ----------------------------------------------------------------
# Pin the major line: `0` follows compatible 0.x minor and bugfix releases, so
# Watchtower can update api/worker (both carry the watchtower.enable label)
# without crossing a breaking major. Use `0.1.0` or `sha-*` for a frozen
# deployment; `latest` would also follow a future 1.0.
IMAGE_PREFIX=ghcr.io/all-the-rest/agent-tasks
IMAGE_TAG=0
OPENCODE_MEMORY_LIMIT=1g
OPENCODE_CPUS=1.0
OPENCODE_RUNTIME_ENABLED=0
# Requires the opencode-runtime profile, which gives the provisioner Docker socket access.
# OPENCODE_RUNTIME_TTL_SECONDS=2592000

# --- inference provider ----------------------------------------------------
# Filled in, the API creates the provider and stores the key encrypted on the
# first start. Leave empty to configure it in the admin UI instead.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_GO_MODEL=
# OPENCODE_GO_MODELS=model-a,model-b
OPENCODE_GO_NAME=OpenCode Go
