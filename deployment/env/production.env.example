# Production stack — deployment/compose.production.yaml
#
# Copy this file to production.env on the deployment host and replace every
# value starting with "replace-with". The file must never be committed.
#
#   cp deployment/env/production.env.example deployment/env/production.env
#   chmod 600 deployment/env/production.env
#   deployment/stack.sh production --profile search up -d

STACK_NAME=production

# --- public endpoint -------------------------------------------------------
# The API also serves the built SPA. It binds to loopback by default; the global
# TLS reverse proxy (Caddy) is the only public listener and proxies to this port.
# Use the public HTTPS URL in PUBLIC_BASE_URL.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
PUBLIC_BASE_URL=https://tasks.example.com
COOKIE_SECURE=true
TRUST_PROXY=true

# --- database --------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=agent_tasks

# --- required secrets ------------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=replace-with-64-hex-characters
# openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=replace-with-base64-32-bytes
# openssl rand -hex 16
SETUP_TOKEN=replace-with-at-least-16-characters
# openssl rand -hex 24
RUNNER_TOKEN=replace-with-at-least-16-characters

# --- first administrator ---------------------------------------------------
# Created only when no ADMIN exists. Leave both empty to use the setup screen
# with SETUP_TOKEN instead.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Administrator
# Invitations only. The admin UI can change this later.
ALLOW_REGISTRATION=false

# --- mail -------------------------------------------------------------------
# Point SMTP_URL at the real relay; without it invitations are copied manually.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=agent-tasks@example.com

# --- search (profile "search") ---------------------------------------------
SEARXNG_URL=http://searxng:8080

# --- browser runner --------------------------------------------------------
RUNNER_ALLOW_HTTP=true
RUNNER_ALLOWED_PORTS=80,443
RUNNER_MAX_SESSIONS=2
RUNNER_SESSION_TTL_MS=900000
RUNNER_CHROMIUM_SANDBOX=true
BROWSER_MEMORY_LIMIT=1g
BROWSER_CPUS=1.0

# --- worker and API --------------------------------------------------------
WORKER_CONCURRENCY=1
RATE_LIMIT_SIGNIN_MAX=5
RATE_LIMIT_SESSION_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# --- images ----------------------------------------------------------------
# Pin the published release. `latest` moves; a version tag does not.
IMAGE_PREFIX=ghcr.io/all-the-rest/agent-tasks
IMAGE_TAG=0.1.0

# --- inference provider ----------------------------------------------------
# Filled in, the API creates the provider and stores the key encrypted on the
# first start. Leave empty to configure it in the admin UI instead.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_GO_MODEL=
# OPENCODE_GO_MODELS=model-a,model-b
OPENCODE_GO_NAME=OpenCode Go
