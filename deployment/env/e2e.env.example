# Browser E2E stack — deployment/compose.e2e.yaml
#
# deployment/stack.sh e2e ... copies this file to e2e.env on first use and
# replaces every __GENERATE__ marker. SETUP_TOKEN and E2E_SETUP_TOKEN receive
# the same random value, as do ADMIN_PASSWORD and E2E_ADMIN_PASSWORD.
#
# Host ports are 8180 (API + SPA) and 8126/1126 (Mailpit), so the local stack can
# stay up while the suite rebuilds and recreates this one.

STACK_NAME=e2e

# --- public endpoint -------------------------------------------------------
HTTP_BIND=127.0.0.1
HTTP_PORT=8180
PUBLIC_BASE_URL=http://localhost:8180
COOKIE_SECURE=false
TRUST_PROXY=false

# --- database --------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=agent_tasks

# --- required secrets ------------------------------------------------------
AUTH_SECRET=__GENERATE__
SECRETS_ENCRYPTION_KEY=__GENERATE__
SETUP_TOKEN=__GENERATE__
RUNNER_TOKEN=__GENERATE__
# Shared only with the network-internal test fake; not a real provider credential.
OPENCODE_PROVISIONER_TOKEN=__GENERATE__
# Deterministic memory/recommendation proposals for the E2E learning checks.
FAKE_RUNTIME_MEMORY_OPS=1

# --- first administrator ---------------------------------------------------
ADMIN_EMAIL=e2e-admin@example.com
ADMIN_PASSWORD=__GENERATE__
ADMIN_NAME=E2E Admin
ALLOW_REGISTRATION=false

# --- Playwright (host-side, exported with `. deployment/env/e2e.env`) -------
E2E_BASE_URL=http://localhost:8180
E2E_SETUP_TOKEN=__GENERATE__
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=__GENERATE__
# The suite starts packages/mock-openai on the host. Docker must reach it; the
# suite falls back to the first non-loopback IPv4. Override when needed:
# E2E_MOCK_BASE_URL=http://172.17.0.1:18099

# --- mail (profile "mail") -------------------------------------------------
MAILPIT_SMTP_PORT=1126
MAILPIT_HTTP_PORT=8126
SMTP_URL=smtp://mailpit:1025
SMTP_FROM=agent-tasks@e2e.test

# --- search (profile "search") ---------------------------------------------
SEARXNG_URL=http://searxng:8080

# --- browser runner --------------------------------------------------------
RUNNER_ALLOW_HTTP=true
RUNNER_ALLOWED_PORTS=80,443
RUNNER_MAX_SESSIONS=2
RUNNER_SESSION_TTL_MS=3660000
RUNNER_CHROMIUM_SANDBOX=true
BROWSER_MEMORY_LIMIT=1g
BROWSER_CPUS=1.0

# --- worker and API --------------------------------------------------------
WORKER_CONCURRENCY=1
# Multi-context browser flows generate more than the production per-IP request budget.
RATE_LIMIT_API_MAX=1000
# The suite signs in several times per minute.
RATE_LIMIT_SIGNIN_MAX=100
RATE_LIMIT_SESSION_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# --- images ----------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/all-the-rest/agent-tasks
IMAGE_TAG=latest
OPENCODE_MEMORY_LIMIT=1g
OPENCODE_CPUS=1.0
