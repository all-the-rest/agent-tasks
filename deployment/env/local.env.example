# Local development stack — deployment/compose.local.yaml
#
# deployment/stack.sh local ... copies this file to local.env on first use and
# replaces every __GENERATE__ marker with a random value. The generated file is
# ignored by git; never commit it.
#
# Host ports are 8090 (API + SPA) and 8025/1025 (Mailpit). They differ from the
# E2E stack (8180 and 8126/1126), so both can run at the same time.

STACK_NAME=local

# --- public endpoint -------------------------------------------------------
HTTP_BIND=127.0.0.1
HTTP_PORT=8090
PUBLIC_BASE_URL=http://localhost:8090
COOKIE_SECURE=false
TRUST_PROXY=false

# --- database --------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=agent_tasks

# --- required secrets ------------------------------------------------------
AUTH_SECRET=__GENERATE__
SECRETS_ENCRYPTION_KEY=__GENERATE__
SETUP_TOKEN=__GENERATE__
RUNNER_TOKEN=__GENERATE__
OPENCODE_SERVER_PASSWORD=__GENERATE__
OPENCODE_PROVISIONER_TOKEN=__GENERATE__

# --- first administrator ---------------------------------------------------
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=__GENERATE__
ADMIN_NAME=Local Admin
# Local instances are usually shared with a second browser/profile.
ALLOW_REGISTRATION=true

# --- mail (profile "mail") -------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_URL=smtp://mailpit:1025
SMTP_FROM=agent-tasks@local.test

# --- search (profile "search") ---------------------------------------------
SEARXNG_URL=http://searxng:8080

# --- browser runner --------------------------------------------------------
RUNNER_ALLOW_HTTP=true
RUNNER_ALLOWED_PORTS=80,443
RUNNER_MAX_SESSIONS=2
RUNNER_SESSION_TTL_MS=3660000
# Set to false only on hosts that forbid unprivileged user namespaces.
RUNNER_CHROMIUM_SANDBOX=true
BROWSER_MEMORY_LIMIT=1g
BROWSER_CPUS=1.0

# --- worker and API --------------------------------------------------------
WORKER_CONCURRENCY=1
RATE_LIMIT_SIGNIN_MAX=20
RATE_LIMIT_SESSION_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info

# --- images ----------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/all-the-rest/agent-tasks
IMAGE_TAG=latest
OPENCODE_MEMORY_LIMIT=1g
OPENCODE_CPUS=1.0
OPENCODE_RUNTIME_ENABLED=0

# --- optional real provider ------------------------------------------------
# Without these the stack has no inference provider; create one in the admin UI
# or point it at a local OpenAI-compatible endpoint.
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_GO_MODEL=
